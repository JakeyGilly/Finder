@using System.Security.Claims
@using Finder.Db.UnitOfWork
@inject IWebUnitOfWork UnitOfWork
@{
    ViewData["Title"] = "Settings";
    var darkMode = await UnitOfWork.UserSettings.GetItemAsync(m => m.UserId == ulong.Parse(User.Claims.First(x => x.Type == ClaimTypes.NameIdentifier).Value) && m.Setting == "DarkMode");
    var devMode = await UnitOfWork.UserSettings.GetItemAsync(m => m.UserId == ulong.Parse(User.Claims.First(x => x.Type == ClaimTypes.NameIdentifier).Value) && m.Setting == "DevMode");
    ViewData["DarkMode"] = darkMode?.Value ?? "false";
}
<form action="/user/settings" method="post">
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" id="DarkMode" name="DarkMode" value="true" @(darkMode?.Value == "true" ? "checked=\"checked\"" : "")/>
        <label class="form-check-label" for="DarkMode">Dark Mode</label>
    </div>
    @if (User.HasClaim("IsBotOwner", "true")) {
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="DevMode" name="DevMode" value="true" @(devMode?.Value == "true" ? "checked=\"checked\"" : "")/>
            <label class="form-check-label" for="DevMode">Dev Mode</label>
        </div>
    }
    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>
    

