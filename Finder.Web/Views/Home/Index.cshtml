@using System.Security.Claims
@using Finder.Db.UnitOfWork
@inject IWebUnitOfWork UnitOfWork
@{
    ViewData["Title"] = "Home Page";
    var isDarkMode = "false";

    if (User.Identity?.IsAuthenticated == true) {
        var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (ulong.TryParse(userIdStr, out var userId) && UnitOfWork?.UserSettings != null) {
            var setting = await UnitOfWork.UserSettings.GetItemAsync(m => m.UserId == userId && m.Setting == "DarkMode");
            isDarkMode = setting?.Value ?? "false";
        }
    }

    ViewData["DarkMode"] = isDarkMode;
}

<div class="text-center mt-5">
    <img src="https://upload.wikimedia.org/wikipedia/commons/c/c9/Finder_Icon_macOS_Big_Sur.png?utm_source=commons.wikimedia.org&utm_campaign=index&utm_content=original" alt="Finder Image" height="200" class="mb-4"/>
    <h1 class="display-4">Finder</h1>
</div>